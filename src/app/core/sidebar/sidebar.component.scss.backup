// ===================================
// BUSINESS SIDEBAR - PRODUCTION READY
// clean Design System
// ===================================

.business-sidebar {
  width: 280px;
  height: 100vh;
  background: #ffffff;
  border-right: 1px solid rgba(255, 255, 255, 0.2);
  box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
  display: flex;
  flex-direction: column;
  position: fixed;
  left: 0;
  top: 0;
  z-index: var(--z-fixed);
  transition: all var(--transition-normal);
  overflow: hidden;

  &.collapsed {
    width: 80px;

    .business-details,
    .nav-text,
    .nav-badge,
    .sidebar-footer {
      opacity: 0;
      visibility: hidden;
    }

    .business-avatar {
      margin-right: 0;
    }

    .nav-link {
      justify-content: center;
      padding: var(--space-4);
    }
  }
}

// ===================================
// SIDEBAR HEADER
// ===================================

.sidebar-header {
  padding: var(--space-6);
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  position: relative;

  .business-info {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-2);

    .business-avatar {
      width: 48px;
      height: 48px;
      border-radius: var(--radius-full);
      display: flex;
      align-items: center;
      justify-content: center;
      border: 2px solid rgba(255, 255, 255, 0.3);
      transition: all var(--transition-normal);

      .avatar-icon {
        font-size: var(--text-xl);
        color: #ffffff;
      }
    }

    .business-details {
      flex: 1;
      min-width: 0;
      transition: all var(--transition-normal);

      .business-name {
        font-family: 'Roboto', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        font-size: var(--text-lg);
        font-weight: var(--font-semibold);
        color: #000000;
        margin-bottom: var(--space-1);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .business-type {
        font-size: var(--text-sm);
        color: #525252;
        margin: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
    }
  }

  .sidebar-toggle {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    width: 32px;
    height: 32px;
    background: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all var(--transition-normal);
    color: #525252;

    &:hover {
      background: #ffffff;
      color: #075985;
      transform: scale(1.1);
    }

    &:focus {
      outline: 2px solid #0284c7;
      outline-offset: 2px;
    }

    .toggle-icon {
      font-size: var(--text-sm);
      font-weight: var(--font-bold);
    }
  }
}

// ===================================
// NAVIGATION
// ===================================

.sidebar-nav {
  flex: 1;
  padding: var(--space-4) 0;
  overflow-y: auto;
  overflow-x: hidden;

  &::-webkit-scrollbar {
    width: 4px;
  }

  &::-webkit-scrollbar-track {
    background: transparent;
  }

  &::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 2px;
  }

  .nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav-item {
    margin-bottom: var(--space-1);
    padding: 0 var(--space-4);

    .nav-link {
      display: flex;
      align-items: center;
      gap: var(--space-4);
      padding: var(--space-4) var(--space-6);
      color: #404040;
      text-decoration: none;
      border-radius: 4px;
      transition: all var(--transition-normal);
      position: relative;
      overflow: hidden;

      &::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 4px;
        transform: scaleY(0);
        transition: transform var(--transition-normal);
      }

      &:hover {
        background: #ffffff;
        color: #075985;
        transform: translateX(4px);

        .nav-icon {
          transform: scale(1.1);
        }
      }

      &:focus {
        outline: 2px solid #0284c7;
        outline-offset: 2px;
      }

      &.active {
        background: #ffffff;
        color: #075985;
        font-weight: var(--font-semibold);

        &::before {
          transform: scaleY(1);
        }

        .nav-icon {
          transform: scale(1.1);
        }
      }

      .nav-icon {
        font-size: var(--text-xl);
        transition: transform var(--transition-normal);
        flex-shrink: 0;
      }

      .nav-text {
        font-family: 'Roboto', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        font-size: var(--text-sm);
        font-weight: var(--font-medium);
        transition: all var(--transition-normal);
        white-space: nowrap;
      }

      .nav-badge {
        background: #dc2626;
        color: #ffffff;
        font-size: var(--text-xs);
        font-weight: var(--font-bold);
        padding: var(--space-1) var(--space-2);
        border-radius: var(--radius-full);
        min-width: 20px;
        height: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-left: auto;
        transition: all var(--transition-normal);
      }
    }
  }

  .nav-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.1);
    margin: var(--space-6) var(--space-8);
  }
}

// ===================================
// SIDEBAR FOOTER
// ===================================

.sidebar-footer {
  padding: var(--space-6);
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  transition: all var(--transition-normal);

  .subscription-status {
    background: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 4px;
    padding: var(--space-4);
    transition: all var(--transition-normal);

    &.trial {
      border-color: rgba(217, 119, 6, 0.3);
      background: #ffffff;
    }

    &.expired {
      border-color: rgba(239, 68, 68, 0.3);
      background: rgba(239, 68, 68, 0.05);
    }

    &.active {
      border-color: rgba(34, 197, 94, 0.3);
      background: #ffffff;
    }

    &.inactive {
      border-color: rgba(107, 114, 128, 0.3);
      background: rgba(107, 114, 128, 0.05);
    }

    .status-info {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      margin-bottom: var(--space-3);

      .status-icon {
        font-size: var(--text-lg);
      }

      .status-text {
        flex: 1;
        min-width: 0;

        .status-label {
          font-family: 'Roboto', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
          font-size: var(--text-sm);
          font-weight: var(--font-semibold);
          color: #262626;
          margin-bottom: var(--space-1);
        }

        .trial-days {
          font-size: var(--text-xs);
          color: #d97706;
          font-weight: var(--font-medium);
          margin: 0;
        }
      }
    }

    .upgrade-btn {
      display: block;
      width: 100%;
      color: #ffffff;
      border: none;
      border-radius: 4px;
      padding: var(--space-3) var(--space-4);
      font-size: var(--text-sm);
      font-weight: var(--font-semibold);
      text-decoration: none;
      text-align: center;
      transition: all var(--transition-normal);
      box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);

      &:hover {
        transform: translateY(-2px);
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
      }

      &:focus {
        outline: 2px solid #0284c7;
        outline-offset: 2px;
      }
    }
  }
}

// ===================================
// RESPONSIVE DESIGN
// ===================================

@media (max-width: 1024px) {
  .business-sidebar {
    transform: translateX(-100%);

    &.mobile-open {
      transform: translateX(0);
    }
  }
}

@media (max-width: 768px) {
  .business-sidebar {
    width: 100%;
    max-width: 320px;
    z-index: var(--z-modal);
  }
}

// ===================================
// ANIMATIONS
// ===================================

@keyframes slideInLeft {
  from {
    transform: translateX(-100%);
    opacity: 0;
  }
  to {
    transform: translateX(0);
    opacity: 1;
  }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

// Animation for sidebar entrance
.business-sidebar {
  animation: slideInLeft 0.3s ease-out;
}

// Smooth transitions for collapsed state
.business-sidebar.collapsed {
  .business-details,
  .nav-text,
  .nav-badge,
  .sidebar-footer {
    transition: opacity var(--transition-normal), visibility var(--transition-normal);
  }
}

// ===================================
// LOGOUT BUTTON & DIVIDER
// ===================================

.nav-divider {
  height: 1px;
  background: rgba(255, 255, 255, 0.1);
  margin: var(--space-4) var(--space-6);
  border: none;
}

.logout-btn {
  background: none;
  border: none;
  width: 100%;
  text-align: left;
  cursor: pointer;
  color: #dc2626 !important;

  &:hover {
    background: rgba(239, 68, 68, 0.1) !important;
    color: #dc2626 !important;
    transform: translateX(4px);

    &::before {
      background: #dc2626;
      transform: scaleY(1);
    }

    .nav-icon {
      transform: scale(1.1);
    }
  }

  &:focus {
    outline: 2px solid #dc2626;
    outline-offset: 2px;
  }

  &:active {
    transform: translateX(2px);
  }
}
