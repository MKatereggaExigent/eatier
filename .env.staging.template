# =============================================================================
# ITIYUM PLATFORM - STAGING ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env.staging and fill in the values
# This is for STAGING environment on Azure
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------
NODE_ENV=staging
PORT=3001

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (Azure PostgreSQL)
# -----------------------------------------------------------------------------
DB_HOST=psql-itiyum-stg.postgres.database.azure.com
DB_PORT=5432
DB_NAME=itiyum_stg
DB_USER=itiyum_admin
DB_PASSWORD=REPLACE_WITH_STAGING_DB_PASSWORD
DB_SSL=true
DATABASE_URL=postgres://itiyum_admin:PASSWORD@psql-itiyum-stg.postgres.database.azure.com:5432/itiyum_stg?sslmode=require

# -----------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# -----------------------------------------------------------------------------
JWT_SECRET=REPLACE_WITH_STAGING_JWT_SECRET_MINIMUM_64_CHARACTERS_LONG
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=REPLACE_WITH_STAGING_SESSION_SECRET

# -----------------------------------------------------------------------------
# CORS & FRONTEND (Azure App Service URLs)
# -----------------------------------------------------------------------------
CORS_ORIGIN=https://app-itiyum-web-stg.azurewebsites.net
FRONTEND_URL=https://app-itiyum-web-stg.azurewebsites.net
API_URL=https://app-itiyum-api-stg.azurewebsites.net

# -----------------------------------------------------------------------------
# GOOGLE OAUTH
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=REPLACE_WITH_YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=https://app-itiyum-api-stg.azurewebsites.net/api/auth/google/callback

# -----------------------------------------------------------------------------
# GOOGLE MAPS
# -----------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=REPLACE_WITH_YOUR_GOOGLE_MAPS_API_KEY

# -----------------------------------------------------------------------------
# OPENAI / AI SERVICES
# -----------------------------------------------------------------------------
OPENAI_API_KEY=REPLACE_WITH_YOUR_OPENAI_API_KEY

# -----------------------------------------------------------------------------
# EMAIL SERVICE
# -----------------------------------------------------------------------------
SENDGRID_API_KEY=REPLACE_WITH_YOUR_SENDGRID_API_KEY
EMAIL_FROM=noreply@itiyum.com

# -----------------------------------------------------------------------------
# AZURE RESOURCES
# -----------------------------------------------------------------------------
AZURE_RESOURCE_GROUP=rg-itiyum-stg
AZURE_ACR_NAME=itiyumacrdev
AZURE_KEY_VAULT=kv-itiyum-stg
AZURE_STORAGE_ACCOUNT=itiyumstoragestg
AZURE_STORAGE_CONNECTION_STRING=REPLACE_WITH_YOUR_STORAGE_CONNECTION_STRING
AZURE_STORAGE_CONTAINER=uploads

# -----------------------------------------------------------------------------
# LOGGING & MONITORING
# -----------------------------------------------------------------------------
LOG_LEVEL=info
APPLICATIONINSIGHTS_CONNECTION_STRING=REPLACE_WITH_YOUR_APP_INSIGHTS_CONNECTION_STRING

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

