# ============================================
# OAuth 2.0 Configuration - All 8 Providers
# ============================================
# Copy this file to .env and fill in your credentials
# Get credentials from each provider's developer console

# Frontend URL (for OAuth callbacks)
FRONTEND_URL=https://itiyum.com

# ============================================
# 1. GOOGLE OAUTH
# ============================================
# Get credentials: https://console.cloud.google.com/
# Enable: Google+ API
# Create OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=https://itiyum.com/api/auth/google/callback

# ============================================
# 2. FACEBOOK OAUTH
# ============================================
# Get credentials: https://developers.facebook.com/
# Create a new app
# Add Facebook Login product
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here
FACEBOOK_CALLBACK_URL=https://itiyum.com/api/auth/facebook/callback

# ============================================
# 3. GITHUB OAUTH
# ============================================
# Get credentials: https://github.com/settings/developers
# Create a new OAuth App
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=https://itiyum.com/api/auth/github/callback

# ============================================
# 4. LINKEDIN OAUTH
# ============================================
# Get credentials: https://www.linkedin.com/developers/
# Create a new app
# Add Sign In with LinkedIn product
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_CALLBACK_URL=https://itiyum.com/api/auth/linkedin/callback

# ============================================
# 5. MICROSOFT OAUTH
# ============================================
# Get credentials: https://portal.azure.com/
# Register a new application in Azure AD
# Add Microsoft Graph API permissions
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here
MICROSOFT_CALLBACK_URL=https://itiyum.com/api/auth/microsoft/callback

# ============================================
# 6. APPLE SIGN IN
# ============================================
# Get credentials: https://developer.apple.com/
# Create a new Service ID
# Enable Sign in with Apple
# Download private key (.p8 file)
APPLE_CLIENT_ID=your_apple_service_id_here
APPLE_TEAM_ID=your_apple_team_id_here
APPLE_KEY_ID=your_apple_key_id_here
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key content here\n-----END PRIVATE KEY-----"
APPLE_CALLBACK_URL=https://itiyum.com/api/auth/apple/callback

# ============================================
# 7. TWITTER/X OAUTH
# ============================================
# Get credentials: https://developer.twitter.com/
# Create a new app
# Enable OAuth 1.0a
TWITTER_CONSUMER_KEY=your_twitter_consumer_key_here
TWITTER_CONSUMER_SECRET=your_twitter_consumer_secret_here
TWITTER_CALLBACK_URL=https://itiyum.com/api/auth/twitter/callback

# ============================================
# 8. INSTAGRAM OAUTH
# ============================================
# Get credentials: https://developers.facebook.com/
# Instagram uses Facebook's OAuth system
# Create a Facebook app and add Instagram Basic Display
INSTAGRAM_CLIENT_ID=your_instagram_client_id_here
INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret_here
INSTAGRAM_CALLBACK_URL=https://itiyum.com/api/auth/instagram/callback

# ============================================
# TESTING
# ============================================
# For local development, use:
# FRONTEND_URL=http://localhost:4200
# And update all callback URLs to use localhost:3001

# For production, use:
# FRONTEND_URL=https://itiyum.com
# And update all callback URLs to use itiyum.com

# ============================================
# NOTES
# ============================================
# 1. All callback URLs must be registered in each provider's developer console
# 2. For production, use HTTPS URLs only
# 3. Apple Sign In requires a .p8 private key file
# 4. Twitter uses OAuth 1.0a (different from others)
# 5. Instagram OAuth is managed through Facebook
# 6. Test each provider individually before deploying
# 7. Keep these credentials SECRET - never commit to git

