# =============================================================================
# ITIYUM PLATFORM - DEVELOPMENT ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env.development and fill in the values
# This file is for LOCAL development with remote Azure services
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# For local Docker development:
DB_HOST=localhost
DB_PORT=5466
DB_NAME=itiyum_platform
DB_USER=itiyum_user
DB_PASSWORD=itiyum_secure_password_2024
DB_SSL=false

# For Azure PostgreSQL (uncomment when using Azure):
# DB_HOST=psql-itiyum-dev.postgres.database.azure.com
# DB_PORT=5432
# DB_NAME=itiyum_dev
# DB_USER=itiyum_admin
# DB_PASSWORD=your-secure-password
# DB_SSL=true

# Full connection string (optional - overrides individual settings)
# DATABASE_URL=postgres://user:password@host:port/database?sslmode=require

# -----------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# -----------------------------------------------------------------------------
JWT_SECRET=dev-super-secret-jwt-key-change-in-production-minimum-32-chars
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d

# Session settings
SESSION_SECRET=dev-session-secret-change-in-production

# -----------------------------------------------------------------------------
# CORS & FRONTEND
# -----------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:4200
FRONTEND_URL=http://localhost:4200
API_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# GOOGLE OAUTH (Optional)
# -----------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# -----------------------------------------------------------------------------
# GOOGLE MAPS (Optional)
# -----------------------------------------------------------------------------
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# -----------------------------------------------------------------------------
# OPENAI / AI SERVICES (Optional)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-your-openai-api-key

# -----------------------------------------------------------------------------
# EMAIL SERVICE (Optional)
# -----------------------------------------------------------------------------
# SENDGRID_API_KEY=your-sendgrid-api-key
# EMAIL_FROM=noreply@itiyum.com

# -----------------------------------------------------------------------------
# FILE UPLOADS
# -----------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Azure Blob Storage (for Azure deployment)
# AZURE_STORAGE_CONNECTION_STRING=your-connection-string
# AZURE_STORAGE_CONTAINER=uploads

# -----------------------------------------------------------------------------
# LOGGING & MONITORING
# -----------------------------------------------------------------------------
LOG_LEVEL=debug

# Azure Application Insights (for Azure deployment)
# APPLICATIONINSIGHTS_CONNECTION_STRING=your-connection-string

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

