# =============================================================================
# ITIYUM PLATFORM - PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# ⚠️  PRODUCTION CONFIGURATION - HANDLE WITH CARE
# Copy this file to .env.production and fill in SECURE values
# NEVER commit this file with real values to git
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3001

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (Azure PostgreSQL)
# -----------------------------------------------------------------------------
DB_HOST=psql-itiyum-prd.postgres.database.azure.com
DB_PORT=5432
DB_NAME=itiyum_prd
DB_USER=itiyum_admin
DB_PASSWORD=REPLACE_WITH_PRODUCTION_DB_PASSWORD
DB_SSL=true
DATABASE_URL=postgres://itiyum_admin:PASSWORD@psql-itiyum-prd.postgres.database.azure.com:5432/itiyum_prd?sslmode=require

# -----------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# -----------------------------------------------------------------------------
# ⚠️  Use strong, unique secrets in production!
# Generate with: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_PRODUCTION_JWT_SECRET_MINIMUM_64_CHARACTERS_LONG
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=REPLACE_WITH_PRODUCTION_SESSION_SECRET

# -----------------------------------------------------------------------------
# CORS & FRONTEND (Production URLs)
# -----------------------------------------------------------------------------
# Replace with your custom domain when configured
CORS_ORIGIN=https://app-itiyum-web-prd.azurewebsites.net
FRONTEND_URL=https://app-itiyum-web-prd.azurewebsites.net
API_URL=https://app-itiyum-api-prd.azurewebsites.net

# Custom domain (when configured):
# CORS_ORIGIN=https://www.itiyum.com
# FRONTEND_URL=https://www.itiyum.com
# API_URL=https://api.itiyum.com

# -----------------------------------------------------------------------------
# GOOGLE OAUTH
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=REPLACE_WITH_YOUR_PRODUCTION_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_YOUR_PRODUCTION_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=https://app-itiyum-api-prd.azurewebsites.net/api/auth/google/callback

# -----------------------------------------------------------------------------
# GOOGLE MAPS
# -----------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=REPLACE_WITH_YOUR_PRODUCTION_GOOGLE_MAPS_API_KEY

# -----------------------------------------------------------------------------
# OPENAI / AI SERVICES
# -----------------------------------------------------------------------------
OPENAI_API_KEY=REPLACE_WITH_YOUR_PRODUCTION_OPENAI_API_KEY

# -----------------------------------------------------------------------------
# EMAIL SERVICE
# -----------------------------------------------------------------------------
SENDGRID_API_KEY=REPLACE_WITH_YOUR_PRODUCTION_SENDGRID_API_KEY
EMAIL_FROM=noreply@itiyum.com

# -----------------------------------------------------------------------------
# AZURE RESOURCES
# -----------------------------------------------------------------------------
AZURE_RESOURCE_GROUP=rg-itiyum-prd
AZURE_ACR_NAME=itiyumacrprd
AZURE_KEY_VAULT=kv-itiyum-prd
AZURE_STORAGE_ACCOUNT=itiyumstorageprd
AZURE_STORAGE_CONNECTION_STRING=REPLACE_WITH_YOUR_PRODUCTION_STORAGE_CONNECTION_STRING
AZURE_STORAGE_CONTAINER=uploads

# -----------------------------------------------------------------------------
# LOGGING & MONITORING
# -----------------------------------------------------------------------------
LOG_LEVEL=warn
APPLICATIONINSIGHTS_CONNECTION_STRING=REPLACE_WITH_YOUR_PRODUCTION_APP_INSIGHTS_CONNECTION_STRING

# -----------------------------------------------------------------------------
# RATE LIMITING (Stricter for production)
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=50

# -----------------------------------------------------------------------------
# SECURITY SETTINGS
# -----------------------------------------------------------------------------
HELMET_ENABLED=true
TRUST_PROXY=true

